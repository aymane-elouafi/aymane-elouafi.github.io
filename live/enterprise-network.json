 "readme": "# Enterprise network lab\n\nA virtualized enterprise network built in VMware, documented step by step: pfSense firewall with VLANs and a DMZ, a VLAN-aware Debian switch, Nginx reverse proxy, Squid proxy, Apache/DVWA and Samba servers, a Suricata IDS, then attack simulations to test detection at each layer.\n\n- [Part 1: main installation](part-1-main-installation/Part%201%20-%20Building%20a%20Segmented%20Enterprise%20Lab.md)\n- [Part 2: attack phase](part-2-attack-phase/screenshots) (in progress)\n- [Roadmap](ROADMAP.md)\n- `configs/`: setup scripts for each VM. `diagrams/`: architecture diagram.\n\nLab only: all addresses are private and the vulnerable apps (DVWA) are deliberately insecure.\n",
 "milestones": [
  {
   "id": "1",
   "label": "pfSense + VLANs + DMZ + Suricata IDS",
   "detail": "Network base, firewall, reverse/forward proxy, IDS",
   "statusText": "built",
   "status": "done"
  },
  {
   "id": "1b",
   "label": "Attack phase against lab 1",
   "detail": "Detection gaps in firewall, IDS, Nginx, Squid",
   "statusText": "in progress (2.1-2.3 done)",
   "status": "wip"
  },
  {
   "id": "2",
   "label": "Active Directory (DC01 + CLIENT01/02 domain-joined)",
   "detail": "Identity: Kerberos, GPO, LDAP. Then AD attacks: Kerberoasting, AS-REP roasting, pass-the-hash, BloodHound",
   "statusText": "planned",
   "status": "todo"
  },
  {
   "id": "3",
   "label": "Wazuh SIEM (manager + indexer + dashboard)",
   "detail": "Central logs from all VMs, agents on Linux and Windows, Suricata + pfSense logs ingested",
   "statusText": "planned",
   "status": "todo"
  },
  {
   "id": "4",
   "label": "FIM (inside Wazuh)",
   "detail": "File Integrity Monitoring on WEB01 (web root, /etc), DC01 (SYSVOL), tested with the web shell from attack 6.x",
   "statusText": "planned",
   "status": "todo"
  },
  {
   "id": "5",
   "label": "EDR/XDR discussion + lab",
   "detail": "Wazuh active response and Sysmon on Windows; compare with real EDR/XDR products (concepts: endpoint telemetry vs network vs identity correlation)",
   "statusText": "planned",
   "status": "todo"
  },
  {
   "id": "6",
   "label": "DLP",
   "detail": "Detect/block sensitive data leaving (payroll.txt on SRV01 as the bait): egress inspection, Wazuh rules, a small open-source DLP or proxy-based content rules",
   "statusText": "planned",
   "status": "todo"
  }
 ],
